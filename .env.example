# Supabase -> Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Clave que Make/Tally manda en la cabecera x-api-key al crear pedidos
API_KEY=pon-aqui-una-cadena-larga-y-aleatoria

# OBSOLETA: ya no se usa. El panel va con ADMIN_EMAILS (mas abajo).
ADMIN_PASSWORD=cambia-esto

# Dominio publico, sin barra final. Se usa para devolver la URL del pedido.
NEXT_PUBLIC_SITE_URL=https://tudominio.pe

# Clave pública para el navegador (Frontend)
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-tu-public-key-aqui
MP_WEBHOOK_SECRET=

# Clave privada para el servidor (Backend - NUNCA la expongas al cliente)
MP_ACCESS_TOKEN=TEST-tu-access-token-aqui

# Yape (Peru). Ponlo en 1 SOLO cuando Mercado Pago te lo haya habilitado
# en la cuenta: si no, la pestana aparece y el cobro falla al final.
# En prueba: celular 111111111 + codigo 123456 = aprobado.
NEXT_PUBLIC_MP_YAPE=0

# Correos que pueden entrar al panel /admin, separados por coma.
# Reemplaza a ADMIN_PASSWORD: el panel exige sesion de Supabase (magic link)
# Y que el correo este en esta lista. Vacio = nadie entra.
ADMIN_EMAILS=tu-correo@gmail.com

# --- Ruta A: par vendedor-de-prueba + comprador-de-prueba ----------------
# Solo para scripts/probar-vendedor-prueba.mjs. Se prueban aparte para no
# pisar las credenciales de arriba antes de saber si funcionan.
#
# El vendedor y el comprador de prueba NO tienen correo real: el panel solo
# lista usuario y contrasena. El correo se deriva del usuario —
# TESTUSER7378515948445158953 -> test_user_7378515948445158953@testuser.com
# y el script lo confirma contra GET /users/me.
#
# Las credenciales del vendedor salen de una ventana de incognito logueada
# COMO el vendedor de prueba: Tus integraciones > la aplicacion >
# Credenciales de prueba. No de la pantalla de tu cuenta real.
MP_VENDEDOR_ACCESS_TOKEN=
MP_VENDEDOR_PUBLIC_KEY=
MP_COMPRADOR_USUARIO=

# Vercel Cron: la manda como "Authorization: Bearer <CRON_SECRET>" a
# /api/cron/purgar (borrado definitivo a los 5 anos). Genera una con:
#   openssl rand -hex 32
CRON_SECRET=

# --- Compra sin cuenta (migraciones 008/009) -------------------------------
# Firma de los enlaces /editar/<id>/<firma>. OBLIGATORIA antes de cobrar:
# sin ella el cobro pasa pero no hay enlace. Genera con: openssl rand -hex 32
# Cambiarla invalida todos los enlaces de edicion ya enviados.
EDICION_SECRETO=

# Resend (correos). Sin RESEND_API_KEY no se envia nada: solo queda en logs.
RESEND_API_KEY=
CORREO_REMITENTE=Dile.pe <hola@envios.meliydani.com>
# Opcional: a donde llegan las respuestas de los clientes
CORREO_RESPUESTA=

# Boton "Simular pago aprobado" en el checkout. Solo funciona con
# MP_MODO=prueba; en produccion se apaga solo aunque quede en 1.
PAGOS_SIMULADOS=
